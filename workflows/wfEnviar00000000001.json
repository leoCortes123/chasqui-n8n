    {
      "parameters": {
        "jsCode": "\nconst inp = $input.first().json;\nconst chat = inp.chat_id;\nconst out = [];\nfor (const r of (inp.respuestas || [])) {\n  if (r.plantilla) out.push({ json: {\n    chat_id: chat, plantilla: r.plantilla, vars: r.vars || {} } });\n}\nreturn out;\n"
      },
