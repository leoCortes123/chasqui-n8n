      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ({{ $json.chat_id }})::bigint AS chat_id, (resolver_plantilla('{{ $json.plantilla }}', '{{ JSON.stringify($json.vars).replaceAll(\"'\",\"''\") }}'::jsonb)) ->> 'texto' AS texto;",
        "options": {}
      },
