    {
      "parameters": {
        "jsCode": "\nconst inp = $input.first().json;\nconst r = (inp.respuestas || []).find(x => x.documento);\nconst binKey = Object.keys($input.first().binary || {})[0];\nreturn [{ json: { chat_id: inp.chat_id, fileName: r?.documento || 'informe.pdf' },\n          binary: { data: $input.first().binary[binKey] } }];\n"
