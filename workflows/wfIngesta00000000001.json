    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT match_resolver_documento( ({{ $json.documento_id }})::bigint ) AS m, (SELECT estado FROM documentos WHERE id=({{ $json.documento_id }})::bigint) AS estado, (SELECT nombre_archivo FROM documentos WHERE id=({{ $json.documento_id }})::bigint) AS nombre, (SELECT count(*) FROM documentos d JOIN sesiones s ON s.id=d.sesion_id   WHERE d.sesion_id=(SELECT sesion_id FROM documentos WHERE id=({{ $json.documento_id }})::bigint)) AS total;",
        "options": {}
