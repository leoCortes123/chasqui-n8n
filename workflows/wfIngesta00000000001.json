    {
      "parameters": {
        "jsCode": "\nconst j = $input.first().json;\nconst chat_id = $('Empaquetar').first().json.chat_id;\nconst nombre = j.nombre || 'archivo';\nlet respuestas;\nif (j.estado === 'error') {\n  respuestas = [{ plantilla:'ingesta.error_archivo',\n    vars:{ nombre_archivo: nombre, motivo:'no se pudo leer' } }];\n} else {\n  respuestas = [{ plantilla:'ingesta.ok',\n    vars:{ nombre_archivo: nombre, total: String(j.total ?? 1) } }];\n}\nreturn [{ json: { chat_id, respuestas } }];\n"
      },
