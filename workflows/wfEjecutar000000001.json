    {
      "parameters": {
        "jsCode": "\nconst ctx = $('Extraer2').first().json;\nconst h = ctx.hallazgos;\nconst l = [];\nl.push('Informe (versión sin narración: no se pudo verificar el texto del modelo).');\nif (h.resumen) l.push(`Productos: ${h.resumen.productos}. Margen promedio: ${h.resumen.margen_promedio_pct ?? 'n/d'}%.`);\nfor (const m of (h.margen_bajo||[])) l.push(`Margen bajo: ${m.producto} (${m.margen_pct}%).`);\nfor (const d of (h.deriva_costo||[])) l.push(`Costo subió: ${d.producto} (${d.deriva_pct}%).`);\nfor (const c of (h.baja_cobertura||[])) l.push(`Se agota pronto: ${c.producto} (~${c.dias_cobertura} días).`);\nfor (const p of (h.pareto||[])) l.push(`Concentra ganancia: ${p.producto} (${p.pct_utilidad}%).`);\nreturn [{ json: { ...ctx, texto: l.join('\\n'), narrado: false } }];\n"
      },
      "id": "InformeSeco",
      "name": "InformeSeco",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        720
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst c = $input.first().json;\nlet cuerpoHtml = (c.texto||'').split(/\\n+/).map(s=>`<p>${s.replace(/[&<>]/g,x=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[x]))}</p>`).join('');\nconst tpl = c.plantilla_pdf;\nlet html = tpl ? tpl.html : '<html><body>{{cuerpo_html}}</body></html>';\nlet css  = tpl ? (tpl.css||'') : '';\nhtml = html.replace('{{css}}', css)\n           .replace('{{cuerpo_html}}', cuerpoHtml)\n           .replace('{{negocio_nombre}}', c.negocio_nombre||'')\n           .replace('{{fecha}}', new Date().toISOString().slice(0,10));\nreturn [{ json: { ...c, html } }];\n"
      },
