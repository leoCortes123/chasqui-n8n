    {
      "parameters": {
        "jsCode": "\nconst prep = $input.first().json.prep;\nconst plantilla = prep.bloqueado ? 'ejecucion.bloqueada_cupo' : 'ejecucion.fallida';\nreturn [{ json: { respuestas: [{ plantilla, vars: {\n  limite: prep.limite ?? null } }] } }];\n"
      },
