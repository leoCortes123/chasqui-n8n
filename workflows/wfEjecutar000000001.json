        "jsCode": "\nconst c = $input.first().json;\nconst buf = Buffer.from(c.html, 'utf8');\nreturn [{ json: c, binary: { 'index.html': {\n  data: buf.toString('base64'), mimeType: 'text/html', fileName: 'index.html' } } }];\n"
      },
      "id": "HtmlABinario",
