        "jsCode": "\nconst c = $('ArmarPDF').first().json;\nconst bin = $('PDF').first().binary;\nreturn [{ json: { respuestas: [{\n  plantilla: 'ejecucion.entregada',\n  vars: { servicio: c.servicio_codigo || 'ventas_compras' },\n  documento: 'informe.pdf'\n}], narrado: c.narrado },\n  binary: { 'informe.pdf': { ...bin.data, fileName: 'informe.pdf', mimeType: 'application/pdf' } } }];\n"
