{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash bin/hook_sesion.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash bin/hook_guardia.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash bin/verificar.sh --rapido"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "decisiones",
    "codigo"
  ]
}
