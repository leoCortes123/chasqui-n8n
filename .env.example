# Copia a .env y rellena. .env NO va a git.

TZ=America/Bogota

# --- Postgres ---------------------------------------------------------------
# Superusuario de la instancia. Solo lo usan las migraciones y los respaldos.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiame_superuser

# Base de negocio. Es la que contiene TODO el comportamiento del sistema.
CHASQUI_DB=chasqui
CHASQUI_DB_USER=chasqui
CHASQUI_DB_PASSWORD=cambiame_chasqui

# Base del runtime de n8n. Separada a propósito: sus tablas de ejecuciones
# no van junto a los datos de negocio.
N8N_DB=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=cambiame_n8n

# Puerto expuesto solo en loopback.
POSTGRES_PORT=5432

# --- n8n --------------------------------------------------------------------
# Genera una vez con:  openssl rand -hex 32
# Si esta clave cambia, TODAS las credenciales guardadas en n8n dejan de
# descifrarse. Fíjala antes del primer arranque y no la pierdas.
N8N_ENCRYPTION_KEY=cambiame_genera_con_openssl_rand_hex_32

N8N_PORT=5678

# URL pública por la que Telegram alcanza a n8n.
# Local: se deja vacía y el servicio `registrador` la descubre del quick tunnel.
# Nube:  se fija al dominio real y se apaga el servicio `registrador`.
# Esta es la ÚNICA variable que cambia al migrar a la nube.
WEBHOOK_URL=

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# Secreto que Telegram devuelve en la cabecera X-Telegram-Bot-Api-Secret-Token.
# wf_router lo verifica y rechaza lo que no coincida: sin esto, cualquiera que
# adivine la URL del túnel puede inyectar mensajes falsos.
# Genera con:  openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# Ruta fija del webhook dentro de n8n. No la cambies sin re-registrar.
TELEGRAM_WEBHOOK_PATH=telegram

# --- WhatsApp (Meta Cloud API) -----------------------------------------------
# Todo sale de developers.facebook.com; el paso a paso está en docs/WHATSAPP.md.
# Con estas variables vacías el canal queda apagado y nada más cambia.

# App > Configuración básica (App ID y App Secret).
WA_APP_ID=
WA_APP_SECRET=

# WhatsApp > Configuración de la API: "ID de la cuenta de WhatsApp Business".
WA_WABA_ID=

# WhatsApp > Configuración de la API: "ID del número de teléfono".
# OJO: es un id numérico de Meta, NO el número de teléfono.
WA_PHONE_NUMBER_ID=

# Token permanente de un usuario de sistema (Business Manager) con permisos
# whatsapp_business_messaging y whatsapp_business_management. El MISMO token va
# en la credencial de n8n "Chasqui WhatsApp" (Header Auth,
# Authorization: Bearer <token>). El token de prueba de 24h sirve para probar,
# pero se vence: para dejarlo andando hace falta el permanente.
WA_ACCESS_TOKEN=

# Lo inventás vos; Meta lo devuelve en el GET de verificación del webhook.
# Genera con:  openssl rand -hex 24
WA_VERIFY_TOKEN=

# Ruta del webhook en n8n. Meta no manda secreto por cabecera (firma el body,
# ver gen_wf_wa_router.py), así que la ruta hace de secreto: agregale un sufijo
# aleatorio, p. ej. whatsapp-$(openssl rand -hex 8).
WA_WEBHOOK_PATH=whatsapp

# --- Portal (PostgREST + Caddy) ----------------------------------------------
# Contraseña del rol `authenticator`, el que usa PostgREST para conectarse. Ese
# rol no puede leer ninguna tabla: solo hacer SET ROLE a portal_anon /
# portal_usuario. Los roles los crea bin/preparar-portal.sh.
# Genera con:  openssl rand -hex 24
PORTAL_DB_PASSWORD=

# Secreto con el que se firman los JWT de la sesión web. Tiene que tener al
# menos 32 caracteres. Si cambia, todas las sesiones abiertas se caen (y eso es
# justo lo que hay que hacer si se filtra).
# Genera con:  openssl rand -hex 32
PORTAL_JWT_SECRET=

# Puerto local del proxy. Solo loopback: hacia afuera se sale por el túnel.
PROXY_PORT=8080

# --- LLM --------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
