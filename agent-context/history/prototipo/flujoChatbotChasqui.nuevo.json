    {
      "parameters": {
        "jsCode": "const trigger = $('Trigger').first().json.message;\nconst userId = trigger.from.id;\nconst username = trigger.from.username || null;\n\nreturn items.map(({ json }) => {\n  const cantidad = Number(json.cantidad ?? 0);\n  const precio   = Number(json.precio_unitario ?? 0);\n  const total    = json.total ? Number(json.total) : cantidad * precio;\n  return {\n    json: {\n      telegram_user_id: userId,\n      telegram_username: username,\n      fecha: json.fecha || null,\n      producto: json.producto || null,\n      categoria: json.categoria || null,\n      cantidad,\n      precio_unitario: precio,\n      total,\n      raw: json,\n    },\n  };\n});"
      },
