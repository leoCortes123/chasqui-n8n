        "query": "INSERT INTO ventas (carga_id, telegram_user_id, fecha, producto, categoria, cantidad, precio_unitario, total)\nVALUES\n{{\n  $('Code').all()\n    .map(i => `(\n      ${ $('InsertRows').first().json.id },\n      ${ i.json.telegram_user_id },\n      '${ i.json.fecha }',\n      '${ String(i.json.producto).replace(/'/g, \"''\") }',\n      '${ String(i.json.categoria).replace(/'/g, \"''\") }',\n      ${ i.json.cantidad },\n      ${ i.json.precio_unitario },\n      ${ i.json.total }\n    )`)\n    .join(',\\n')\n}}",
